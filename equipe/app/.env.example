APP_NAME="Neurologia Hospitalar"
APP_ENV=production
APP_KEY=
# Nunca deixar true em produção — expõe stack trace com detalhes internos.
APP_DEBUG=false
APP_URL=https://drfernandofreua.com.br/visitas
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/home/USUARIO/equipe/data/neurologia.sqlite3
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_FOREIGN_KEYS=true

# Sessão em arquivo (equipe/app/storage/framework/sessions), fora de
# public_html — evita escrita constante no SQLite a cada request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Secure exige HTTPS real; em dev local sem TLS, sobrescrever para false
# no .env local (nunca em produção).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sem worker residente — cada job roda na própria requisição.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
