# Dados clínicos e segredos — nunca versionar
equipe/data/*.sqlite3
equipe/data/*.sqlite3-wal
equipe/data/*.sqlite3-shm
equipe/backups/*
!equipe/backups/.gitkeep
equipe/exports/*
!equipe/exports/.gitkeep
equipe/logs/*
!equipe/logs/.gitkeep

# Backend (Laravel) — vendor/.env já ignorados pelo .gitignore interno de equipe/app,
# duplicado aqui por segurança caso alguém rode git fora daquele diretório.
equipe/app/vendor/
equipe/app/.env
equipe/app/.env.*
!equipe/app/.env.example
equipe/app/storage/*.key
equipe/app/storage/logs/*
!equipe/app/storage/logs/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/

# Build compilado — gerado localmente (VITE_BASE_PATH=/visitas/ npm run build)
# e enviado direto ao servidor, não versionado. Fica junto com index.php/
# .htaccess dentro de public_html/visitas/ (sem subpasta "build/" própria —
# ver routes/web.php e vite.config.js).
public_html/visitas/assets/*
!public_html/visitas/assets/.gitkeep
public_html/visitas/icons/
public_html/visitas/index.html
public_html/visitas/manifest.webmanifest
public_html/visitas/favicon.svg
public_html/visitas/sw.js
public_html/visitas/registerSW.js
public_html/visitas/workbox-*.js

# Diversos
.DS_Store
Thumbs.db
*.log

# Arquivos internos do Claude Code (locks de sessão, etc.) — nunca versionar
.claude/

# Pacotes de upload gerados localmente (nunca versionados)
*.zip
