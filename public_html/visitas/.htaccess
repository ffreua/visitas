# /visitas/ tem que passar pelo Laravel (index.php), nunca ser servido como
# index.html estático: é na resposta do Laravel que vem o cookie XSRF-TOKEN
# que o axios reenvia como X-XSRF-TOKEN. Sem isso o primeiro login toma 419.
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Arquivos que existem de verdade (build/, assets/, icons/, manifest,
    # sw.js) são servidos direto pelo Apache — só cai no Laravel (index.php)
    # o que não existe fisicamente: /api/* e as rotas do SPA (seção 7 do PRD).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Nunca liste o conteúdo do diretório nem exponha .env/configurações
# caso algum arquivo sensível seja enviado por engano para public_html.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
